{
  // Cloudflare Worker 設定檔：網頁、API、LINE webhook、每分鐘排程都在同一個 Worker
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "line-voice-reminder",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // 保留在 Cloudflare 後台手動加的變數，避免每次更新程式時被清掉
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/line/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "froglssh-reminder" }
  ],
  "triggers": {
    // 每分鐘檢查一次到期提醒，並清除過期資料
    "crons": ["* * * * *"]
  },
  "vars": {
    "OWNER_NAME": "froglssh",
    // 已送出的提醒保留多久（分鐘）。10080 = 7 天；測試自動刪除時可暫時改成 3
    "RETENTION_MINUTES": "10080",
    "LINE_API_BASE": "https://api.line.me",
    // 語音 AI 模型與聲音（Kore 為女聲；可改成 Puck、Charon 等）
    "GEMINI_MODEL": "gemini-3.8-live",
    "GEMINI_VOICE": "Kore"
  },
  "observability": { "enabled": true }
}
